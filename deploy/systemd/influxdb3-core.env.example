# /etc/influxdb3/influxdb3-core.env  —— 权限 0600，属主 root:influxdb3
# 只被 deploy/systemd/influxdb3-core.service 的 EnvironmentFile= 读取。
#
# 这个文件只放「追加的 serve flag」。systemd 里 $VAR 按空格拆词，所以一个词就是一个 flag，
# 值不要带空格；要用带空格的值（比如 --template-tag 那种，Core 也用不上）就别走这条路。
#
# 改完必须 restart，`influxdb3 serve` 不热加载：
#   systemctl daemon-reload && systemctl restart influxdb3-core

# 默认不带任何追加参数（unit 里也给了空默认值，删掉这行也能启动）
INFLUXDB3_EXTRA_ARGS=

# ---- 常用可选项（按需取消注释，逐项加）----
#
# 查询侧护栏：Core 没有 compactor，gen1 文件只增不合；跨多表/多天查询容易踩文件数上限
# --query-file-limit 默认 432（≈单表 3 天的文件量），超限的后果官方描述为 RAM 飙升甚至 OOM
# INFLUXDB3_EXTRA_ARGS=--query-file-limit=1000 --datafusion-max-parquet-fanout=2000
#
# 并发查询数（3.10 起可运行时调整）；与 unit 里的 MemoryMax 一起看
# INFLUXDB3_EXTRA_ARGS=--max-concurrent-queries=8
#
# WAL：默认 1s flush、100000 缓冲写。写入型负载想减少 fsync 次数可以放大，
# 代价是崩溃后回放的窗口变长
# INFLUXDB3_EXTRA_ARGS=--wal-flush-interval=5s --wal-max-buffered-writes=200000
#
# 想监听全网卡（配合鉴权 + 反代，别再配 --without-auth）：改 unit 里的 --http-bind
#
# 缓存淘汰周期（默认 10s）；last_cache 本身没有内存上限开关，100 万设备场景要慎建
# INFLUXDB3_EXTRA_ARGS=--last-cache-eviction-interval=60s
