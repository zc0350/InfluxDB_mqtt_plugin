# docker compose 变量：cp .env.example .env 后按需修改。
# compose 自动读取同目录 .env；deploy/scripts/bootstrap.sh 与 verify-e2e.sh 也读它。
# 桥接器自己的连接参数与凭据在 bridge.env，不在这里 —— 避免两处填不一致。

# ---- InfluxDB 3 Core ----
# 官方镜像在 Docker Hub 是 library 镜像 influxdb:3-core（可锁 influxdb:3.12.2-core）；
# quay.io/influxdb/influxdb3-core 是备选仓库，按 commit 打 tag，别指望它有 latest。
INFLUXDB3_IMAGE=influxdb:3-core
NODE_ID=node0
DB_NAME=mqtt
# 建库时的保留期。留空 = 不限（推荐：按年分表后按表清理更可控）。
# 单位只有 h/d/w/mo/y，最小 1h，none 表示不限；写成 3m/30s 会被拒。建库后改不了。
RETENTION_PERIOD=
# 8181 默认只绑 127.0.0.1：--without-auth 时任何能连到该端口的人都能读写全库。
# 需要远程访问时改绑地址，并务必自行加反代鉴权，或按 deploy.md §4.3 切鉴权版。
INFLUXDB3_BIND=127.0.0.1
INFLUXDB3_PORT=8181
# 走 docker-compose.auth.yml 时才用：token 文件在 influxdb3-data 卷里，serve 读它
INFLUX_ADMIN_TOKEN_FILE=/var/lib/influxdb3/admin.token
# 巡检/验证脚本查询时用的同一个 token 明文（无鉴权栈留空即可）
INFLUX_ADMIN_TOKEN=

# ---- MQTT broker ----
MQTT_IMAGE=eclipse-mosquitto:2
# 设备要从外网连进来就得开放 1883；只在同机跑测试时可改成 127.0.0.1。
MQTT_BIND=0.0.0.0
MQTT_PORT=1883
# bootstrap.sh 用 mosquitto_passwd 预建一个测试设备账号（桥接器账号取自 bridge.env）
DEVICE_MQTT_USER=TT10002
DEVICE_MQTT_PASS=change-me-device
