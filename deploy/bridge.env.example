# 桥接器容器环境变量（compose 的 env_file）。这里的值会覆盖 config.toml 同名项。
# cp bridge.env.example bridge.env 后填写；bridge.env 含凭据，不要提交。

# 容器内路径：WAL 落在 bridge-data 卷
WAL_PATH=/data/bridge.db

# broker / DB 地址用 compose 服务名（config.toml 里保留 127.0.0.1 方便本机裸跑）
MQTT_HOST=mosquitto
MQTT_PORT=1883
INFLUX_URL=http://influxdb3:8181
INFLUX_DATABASE=mqtt
# 后端代际：v3（默认，InfluxDB 3 Core）/ v2（OSS）/ v1（1.8）。写路径三家通用，
# 建库、探活、查询、删表按它分派；换代还要同步改 INFLUX_URL 的路径与凭据形式。
INFLUX_VERSION=v3
# 启动时自动建库/建 bucket（幂等，失败只告警不拦启动）。不想让桥接器碰管理接口就设 false。
INFLUX_AUTO_CREATE_DB=true
# 建库时带的保留期，只在「库还不存在」时生效：v3 建库后改不了，v1 忽略（用 retention policy）。
# 单位 h/d/w/mo/y，最小 1h；留空 = 不限。bootstrap.sh 用的是 .env 里的 RETENTION_PERIOD，
# 那才是真正建库的那一次 —— 两边要么都留空，要么填同一个值。
INFLUX_RETENTION_PERIOD=

# MQTT 账号：bootstrap.sh 会把它写进 mosquitto/passwd
MQTT_USERNAME=bridge
MQTT_PASSWORD=change-me-bridge

# InfluxDB token。默认无鉴权栈留空；走 docker-compose.auth.yml 时填 admin token
INFLUX_TOKEN=

# 单产品收紧订阅面时填；留空 = ${productKey} 展开成 +
PRODUCT_KEY=
YEAR_TZ_OFFSET_MINUTES=480

# persisted = SQLite 落库即 ACK（默认，吞吐高）；written = InfluxDB 2xx 才 ACK（强，但受 DB 延迟牵制）
BRIDGE_ACK_MODE=persisted
LOG_LEVEL=INFO
